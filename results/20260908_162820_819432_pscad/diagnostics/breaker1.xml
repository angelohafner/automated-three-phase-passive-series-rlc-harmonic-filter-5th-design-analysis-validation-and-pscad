#IF ENAB==1
 BrP = $A $B   BREAKER  1.0E6
#ENDIF
</segment><segment name="Dsdyn" id="1861042463" classid="CoreSegment">#BEGIN
      CALL COMPONENT_ID(ICALL_NO,$#Component)
 #IF ENAB==0
      CALL E1PBRKR1_CFG($RON,$ROFF,$CLVL)
 #ELSE
      CALL E1PBRKR1_CFG($RON,2.0*$ROFF,$CLVL)
      CALL E1PBRKR1_CFG($PRER,2.0*$ROFF,$CLVL)
      CALL CHECK_PIR($RON,$ROFF,$PRER,"BREAKER1")
 #ENDIF
#ENDBEGIN
#LOCAL INTEGER IVD1_1
#LOCAL INTEGER IVD1_2
#STORAGE INTEGER:1
      IVD1_2 = NSTORI
      NSTORI = NSTORI + 1
#IF ENAB==0
 #STORAGE RTCF:1
      CALL E1PBRKR1_EXE($SS,$NBR,$RON,$ROFF,$OPCUR,NINT(1.0-$NAME))
      IVD1_1 = 2*E_BtoI(OPENBR($NBR,$SS))
#ELSE
 #STORAGE REAL:2 INTEGER:2 RTCF:2
 #LOCAL INTEGER IVD1_3
 #LOCAL INTEGER IVD1_4
 #FUNCTION REAL EMTDC_VVDC
 #SUBROUTINE PREINSERT11 Pre-Post insertion resistor branch for 1 phase breaker
!  Breaker and Pre-Post Insertion Resistor Branches
      CALL PREINSERT11(NINT($NAME),$POSTINS,$TDR,$TD,$TDBO,($VDC:A:B),IVD1_3,IVD1_4)
!
!  Breaker and Pre-Post Insertion Resistor Branches
      CALL E1PBRKR1_EXE($SS,$NBR,$RON,2.0*$ROFF,$OPCUR,IVD1_3)
      CALL E1PBRKR1_EXE($SS,$BrP,$PRER,2.0*$ROFF,$OPCUR,IVD1_4)
      IVD1_1  = E_BtoI(OPENBR($NBR,$SS)) + E_BtoI(OPENBR($BrP,$SS))
#ENDIF
      IF (FIRSTSTEP .OR. (STORI(IVD1_2) .NE. IVD1_1)) THEN
         CALL PSCAD_AGI2(ICALL_NO,$#Component,IVD1_1,"BOpen")
      ENDIF
#IF ENAB == 0
      STORI(IVD1_2) = 2*E_BtoI(OPENBR($NBR,$SS))
#ELSE
      STORI(IVD1_2) = E_BtoI(OPENBR($NBR,$SS)) + E_BtoI(OPENBR($BrP,$SS))
#ENDIF
#OUTPUT INTEGER SBR {IVD1_1}
</segment><segment name="Dsout" id="1485607480" classid="CoreSegment">#FUNCTION REAL VBRANCH
#IF ENAB==0
! Single phase breaker current
      #OUTPUT REAL IBR {$CBR:NBR}
#ELSE
!  Breaker and Pre-Post Insertion Resistor Branch Current
      #OUTPUT REAL IBR {$CBR:NBR + $CBR:BrP}
#ENDIF
      #OUTPUT REAL VBR {VBRANCH($SS,$NBR)}
!</segment><segment classid="CoreSegment" id="1728586810" name="FlyBy">Single Phase Breaker</segment></script><graphics size="4"><paramlist><param name="show_border" value="0" /><param name="show_grid" value="0" /><param name="size" value="0" /><param name="orient" value="1" /><param name="lock_style" value="3" /><param name="lock_cx" value="0" /><param name="lock_cy" value="0" /></paramlist><Port id="196681617" classid="Port" x="36" y="0"><paramlist><param name="name" value="A" /><param name="internal" value="false" /><param name="cond" value="true" /><param name="mode" value="3" /><param name="datatype" value="0" /><param name="electype" value="0" /><param name="dim" value="1" /></paramlist></Port><Port id="737515399" classid="Port" x="-36" y="0"><paramlist><param name="name" value="B" /><param name="internal" value="false" /><param name="cond" value="true" /><param name="mode" value="3" /><param name="datatype" value="1" /><param name="electype" value="0" /><param name="dim" value="1" /></paramlist></Port><Gfx classid="Graphics.Line" id="179085267" x="-2" y="-18"><vertex x="0" y="0" /><vertex x="0" y="9" /><paramlist><param name="color" value="Black" /><param name="dasharray" value="0" /><param name="thickness" value="0" /><param name="port" value="" /><param name="cond" value="(ViewB==0)&amp;&amp;(BOpen!=0)" /><param name="lock" value="false" /></paramlist></Gfx><Gfx classid="Graphics.Line" id="511070784" x="-2" y="-2"><vertex x="0" y="0" /><vertex x="0" y="8" /><paramlist><param name="color" value="Black" /><param name="dasharray" value="0" /><param name="thickness" value="0" /><param name="port" value="" /><param name="cond" value="(ViewB==0)&amp;&amp;(BOpen!=0)" /><param name="lock" value="false" /></paramlist></Gfx><Gfx classid="Graphics.Path" id="275335648" x="-13" y="-5" w="22" h="21"><paramlist><param name="color" value="Black" /><param name="dasharray" value="0" /><param name="thickness" value="0" /><param name="port" value="" /><param name="start" value