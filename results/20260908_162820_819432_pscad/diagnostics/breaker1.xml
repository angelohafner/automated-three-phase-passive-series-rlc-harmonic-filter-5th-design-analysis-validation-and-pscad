<Definition classid="UserCmpDefn" name="breaker1" url="" view="false" instances="0" date="0" crc="74779482" id="1926816729" group="Breakers Faults"><paramlist><param name="Description" value="Single Phase Breaker" /></paramlist><form name="Single Phase Breaker" w="530" h="420" splitter="70" commentlines="4" category-width="180"><category name="Configuration" visible="true"><parameter type="Real" name="NAME" desc="Breaker Name" content_type="Variable" min="0" max="1" unit="" group="" helpmode="Append" intent="Input" dim="1" animate="false"><value>BRK</value><cond type="Enable" /><help /><vis /></parameter><parameter type="Choice" name="OPCUR" desc="Open Possible at any Current?" group="" helpmode="Overwrite" animate="false"><value>0</value><cond type="Enable" /><help>Select Yes to open the breaker at any current, if not breaker will not open until the current is below the chopping limit</help><vis /><choice>0 = No</choice><choice>1 = Yes</choice></parameter><parameter type="Choice" name="ENAB" desc="Use Pre-Insertion Resistance?" group="" helpmode="Overwrite" animate="false"><value>0</value><cond type="Enable" /><help>Select Yes to No to enable/disable pre-insertion resistance</help><vis /><choice>0 = No</choice><choice>1 = Yes</choice></parameter><parameter type="Choice" name="ViewB" desc="Graphics Display" group="" helpmode="Overwrite" animate="false"><value>1</value><cond type="Enable">(true)</cond><help /><vis /><choice>0 = Low Voltage Display</choice><choice>1 = High Voltage Display</choice></parameter><parameter type="Real" name="CLVL" desc="Current Chopping Limit" content_type="Constant" min="-1E+308" max="1E+308" unit="kA" group="" helpmode="Append" intent="Input" dim="1" animate="false"><value>0.0</value><cond type="Enable">OPCUR==0</cond><help /><vis /></parameter><cond>true</cond></category><category name="Breaker Main Data" visible="true"><parameter type="Real" name="ROFF" desc="Breaker OPEN  Resistance" content_type="Constant" min="0.001" max="1E+308" unit="ohm" group="" helpmode="Append" intent="Input" dim="1" animate="false"><value>1.E6</value><cond type="Enable" /><help /><vis /></parameter><parameter type="Real" name="RON" desc="Breaker CLOSED Resistance" content_type="Constant" min="0" max="1E+308" unit="ohm" group="" helpmode="Append" intent="Input" dim="1" animate="false"><value>0.005</value><cond type="Enable" /><help /><vis /></parameter><cond>true</cond></category><category name="Pre-Insertion Data" visible="true"><cond>(ENAB)</cond><parameter type="Real" name="PRER" desc="Pre-Insertion Resistance" content_type="Constant" min="0.001" max="1E+308" unit="ohm" group="" helpmode="Append" intent="Input" dim="1" animate="false"><value>0.1</value><cond type="Enable" /><help /></parameter><parameter type="Real" name="TD" desc="Time Delay for Closing Breaker" content_type="Variable" min="0" max="1E+308" unit="s" group="" helpmode="Append" intent="Input" dim="1" animate="false"><value>0.0</value><cond type="Enable" /><help /></parameter><parameter type="Real" name="TDR" desc="Time Delay for Bypassing Pre-Ins." content_type="Variable" min="0" max="1E+308" unit="s" group="" helpmode="Append" intent="Input" dim="1" animate="false"><value>0.05</value><cond type="Enable" /><help /></parameter><parameter type="Choice" name="PostIns" desc="Post-insertion Removal" group="" helpmode="Overwrite" animate="false"><value>0</value><cond type="Enable" /><help>Select how the post-insertion resistance be removed</help><choice>0 = at next current zero</choice><choice>1 = after a specified time</choice></parameter><parameter type="Real" name="TDBO" desc="Minimum Time for Post-insertion Removal" content_type="Variable" min="0" max="1E+308" unit="s" group="" helpmode="Append" intent="Input" dim="1" animate="false"><value>0.005</value><cond type="Enable">PostIns</cond><help /></parameter></category><category name="Internal Output Variables" visible="true"><parameter type="Text" name="IBR" desc="Name for Breaker Current (kA)" group="" helpmode="Append" allowemptystr="true"><value /><regex>^[a-zA-Z][a-zA-Z0-9_]*$</regex><error_msg>Name must begin with a letter and can contain only letters, numbers and _</error_msg><cond type="Enable" /><help /></parameter><parameter type="Text" name="SBR" desc="Name for Breaker Status" group="" helpmode="Append" allowemptystr="true"><value /><regex>^[a-zA-Z][a-zA-Z0-9_]*$</regex><error_msg>Name must begin with a letter and can contain only letters, numbers and _</error_msg><cond type="Enable" /><help /></parameter><parameter type="Text" name="VBR" desc="Name for Voltage across Breaker (kV)" group="" helpmode="Append" allowemptystr="true"><value /><regex>^[a-zA-Z][a-zA-Z0-9_]*$</regex><error_msg>Name must begin with a letter and can contain only letters, numbers and _</error_msg><cond type="Enable" /><help /></parameter><cond>true</cond></category><category name="Animation State" visible="true"><parameter type="Choice" name="BOpen" desc="breaker status" animate="true" group="" helpmode="Append"><value>0</value><cond type="Enable" /><help /><choice>0 = close</choice><choice>2 = open</choice></parameter><cond>true</cond></category></form><svg viewBox="-200 -200 200 200"><port model="Natural" name="A" x="36" y="0" dim="1" mode="" type="NonRemovable">true</port><port model="Natural" name="B" x="-36" y="0" dim="1" mode="" type="NonRemovable">true</port><line x1="-36" y1="0" x2="-9" y2="0" stroke="Black" stroke-dasharray="none" stroke-width="0.2" /><line x1="4" y1="0" x2="36" y2="0" stroke="Black" stroke-dasharray="none" stroke-width="0.2" /><cond>(ViewB==0)&amp;&amp;(BOpen!=0)</cond><line x1="-2" y1="-18" x2="-2" y2="-9" stroke="Black" stroke-dasharray="none" stroke-width="0.2" /><line x1="-2" y1="-2" x2="-2" y2="6" stroke="Black" stroke-dasharray="none" stroke-width="0.2" /><path d="M4.309 -3.192 A11 10 0 0 0 -8.309 -3.192" arc="-13,-5,9,16,55,70" stroke="Black" stroke-dasharray="none" stroke-width="0.2" /><cond>(ViewB==0)&amp;&amp;(BOpen!=2)</cond><line x1="-2" y1="1" x