==1)&amp;&amp;(Spec==0)</cond><text x="42" y="34" stroke="Black" fill="Black" font-size="Small" text-anchor="Middle">f</text></svg><script><segment name="Branch" id="690557892" classid="CoreSegment">#IF Type==6
    BA =  $NB  $NA     SOURCE   0.0 0.0 0.0    /
#ELSEIF Type==2
    BA =  $NB $IA    SOURCE     1.0  0.0  0.0   /
    BP1 = $IA  $NA   1.0  0.1  0.0  /
    BP2 = $IA  $NA   1.0  0.1  0.0  /
#ELSE
    BA =  $NB  $NA     SOURCE   1.0 0.1 1.0  /
#ENDIF</segment><segment name="Dsdyn" id="1009809196" classid="CoreSegment">#BEGIN
 #IF Type==1
      CALL E_BRANCH_CFG($BA,$SS,1,0,0,$R,0.0,0.0)
 #ELSEIF Type==2
      CALL E_BRANCH_CFG($BA,$SS,1,0,0,$Rs,0.0,0.0)
      CALL E_BRANCH_CFG($BP1,$SS,1,0,0,$Rp,0.0,0.0)
      CALL E_BRANCH_CFG($BP2,$SS,0,1,0,0.0,$Lp,0.0)
 #ELSEIF Type==3
  #LOCAL INTEGER IVD1_1
  #LOCAL INTEGER IVD1_2
      IVD1_1 = 1
      IVD1_2 = 1
      IF ($L .LE. 1.0E-38) IVD1_1 = 0
      IF ($C .LE. 1.0E-38) IVD1_2 = 0
      CALL E_BRANCH_CFG($BA,$SS,1,IVD1_1,IVD1_2,$R_,$L,$C)
 #ELSEIF Type==4
      IF ($L_ .LE. 1.0E-38) THEN
        CALL E_BRANCH_CFG($BA,$SS,1,0,0,1.0E-38,0.0,0.0)
      ELSE
        CALL E_BRANCH_CFG($BA,$SS,0,1,0,0.0,$L_,0.0)
      ENDIF
 #ELSEIF Type==5
      IF ($C_ .LE. 1.0E-38) THEN
        CALL E_BRANCH_CFG($BA,$SS,1,0,0,1.0E-38,0.0,0.0)
      ELSE
        CALL E_BRANCH_CFG($BA,$SS,0,0,1,0.0,0.0,$C_)
      ENDIF
 #ENDIF
 #IF ((Spec==0)&amp;&amp;(Cntrl==0))||(Spec==1)
      CALL E_1PVSRC_CFG($AC,$Spec,$Type,$Vm,$f,$Ph,~
  #CASE Type-1 {~$R,0.0,0.0,~}{~$Rs,$Lp,$Rp,~}{~$R_,$L,$C,~}{~0.0,$L_,0.0,~}{~0.0,0.0,$C_,~}{~0.0,0.0,0.0,~}
  #CASE Spec {~0.0,0.0,$TC)}{~$P,$Q,$TC)}
 #ELSE
      RTCF(NRTCF) = ~
  #CASE AC {~0.0} {~$Ph*PI_BY180}
      RTCF(NRTCF+1) = $TC
      NRTCF = NRTCF + 2   
 #ENDIF
#ENDBEGIN
#STORAGE LOGICAL:1 INTEGER:6 REAL:8
#LOCAL REAL RVD1_1
#LOCAL REAL RVD1_2
#LOCAL REAL RVD1_3
#LOCAL REAL RVD1_4
#IF Spec==0
 #CASE Cntrl {!~}{! Mag: Externally controlled peak ~}{! Mag: Externally controlled RMS ~}
 #CASE AC {~ DC source: Type:~} {~ Single Phase AC source: Type:~}
#ELSE
 #CASE AC {! DC~} {! AC~}
 #CASE 0 {~ source with specified terminal conditions: Type:~} 
#ENDIF
 #CASE Type-1 {~ R} {~ RRL} {~ RLC} {~ L} {~ C} {~ Ideal}
#IF ((Spec==0)&amp;&amp;(Cntrl==0))||(Spec==1)
 #STORAGE RTCF:4
      RVD1_1 = RTCF(NRTCF)
      RVD1_2 = RTCF(NRTCF+1)
      RVD1_3 = RTCF(NRTCF+2)
      RVD1_4 = RTCF(NRTCF+3)
      NRTCF = NRTCF + 4
#ELSEIF (Spec==0)&amp;&amp;(Cntrl!=0)
 #STORAGE RTCF:2
 #IF Cntrl==1
      RVD1_1 = $Mag
 #ELSEIF AC==1
      RVD1_1 = $MagRMS * SQRT_2
 #ELSE
      RVD1_1 = $MagRMS
 #ENDIF
 #IF AC==1
      RVD1_2 = $freq * TWO_PI
 #ELSE
      RVD1_2 = 0.0
 #ENDIF
      RVD1_3 = RTCF(NRTCF)
      RVD1_4 = RTCF(NRTCF+1)
      NRTCF  = NRTCF + 2
#ENDIF
      CALL EMTDC_1PVSRC($SS,$BA,RVD1_4,$AC,RVD1_1,RVD1_2,RVD1_3)</segment><segment name="Dsout" id="1176236774" classid="CoreSegment">#OUTPUT REAL CUR {$CBR:BA}</segment><segment name="FlyBy" id="1521886892" classid="CoreSegment">Simple single phase source
